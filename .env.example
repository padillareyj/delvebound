APP_NAME=Delvebound
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://delvebound.host
DISPLAY_TIMEZONE=Asia/Bangkok

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Database: one host, three users (DESIGN.md section 2.1)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=delvebound
DB_USERNAME=delve_web
DB_PASSWORD=change-me-web
DB_SIM_USERNAME=delve_sim
DB_SIM_PASSWORD=change-me-sim
DB_ADMIN_USERNAME=delve_admin
DB_ADMIN_PASSWORD=change-me-admin

# Sessions, cache, queue: files and sync, so Laravel adds no tables
SESSION_DRIVER=file
SESSION_LIFETIME=720
SESSION_COOKIE=delvebound_session
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

LOG_CHANNEL=daily
LOG_LEVEL=info

# Game
BALANCE_FILE=config/balance.json
ALLOW_SIGNUP=true
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
STALE_RUN_MINUTES=15
LOG_RETENTION_DAYS=60

VITE_APP_NAME="${APP_NAME}"
